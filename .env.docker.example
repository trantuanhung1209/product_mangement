# Full-Docker stack (docker-compose.yml). Copy to .env.docker and replace every <...>.
# Service hostnames (postgres, redis, minio) replace localhost. Never commit .env.docker.
# Use hex values (openssl rand -hex 32) for passwords so they are safe inside DATABASE_URL.

# PostgreSQL container
POSTGRES_USER=product_catalog
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=product_catalog

# MinIO container (root user) and the API's S3 client use the same pair.
MINIO_ROOT_USER=product_catalog_minio
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

# Backend
DATABASE_URL=postgresql+psycopg://product_catalog:<same as POSTGRES_PASSWORD>@postgres:5432/product_catalog
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=product_catalog_minio
MINIO_SECRET_KEY=<same as MINIO_ROOT_PASSWORD>
MINIO_BUCKET=product-images
MINIO_SECURE=false

JWT_SECRET_KEY=<openssl rand -hex 32>
PRODUCT_CURSOR_HMAC_KEY=<openssl rand -hex 32>
RATE_LIMIT_KEY_SECRET=<openssl rand -hex 32>

# The browser talks to Nginx only, so the page origin is the Nginx origin.
CORS_ORIGINS=["http://localhost:8080"]
# Nginx's fixed address on the compose network (see docker-compose.yml).
TRUSTED_PROXY_IPS=["172.28.0.10"]
# Plain HTTP on localhost: Secure cookies would not be sent. Set true behind HTTPS.
JWT_COOKIE_SECURE=false
SECURITY_HSTS_ENABLED=false

# Tuning: same values as .env.example (and the code defaults).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_MINUTE=10
RATE_LIMIT_MUTATION_PER_MINUTE=30
RATE_LIMIT_IMAGE_UPLOAD_PER_MINUTE=10
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=60

APP_ENV=production

# Registration by email OTP (Resend). Verify the sending domain in the Resend dashboard first.
# Independent HMAC key for OTP hashes. Generate with: openssl rand -hex 32. Never commit the real value.
OTP_HMAC_KEY=<openssl rand -hex 32>
# Resend API key (secret). Without it, development does not deliver mail (nothing printed) and production returns 503.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@uside.id.vn
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_REGISTRATION_PER_MINUTE=5
# Limit for forgot/reset/change password, per IP and per email (change: per user).
RATE_LIMIT_PASSWORD_PER_MINUTE=5

# Optional: host port for Nginx (default 8080), and MinIO image on non-ARM hosts.
# WEB_PORT=8080
# MINIO_IMAGE=firstfinger/minio:latest-amd64
