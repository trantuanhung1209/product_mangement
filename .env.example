# Backend: origins allowed to call the API. Pydantic parses this JSON array.
CORS_ORIGINS=["http://localhost:5173"]

# Frontend: URL used by Axios to reach FastAPI.
VITE_API_URL=http://localhost:8000

# PostgreSQL. Keep real credentials only in .env, never commit them.
DATABASE_URL=postgresql+psycopg://product_catalog:change_me@localhost:5432/product_catalog
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis is optional: the API falls back to PostgreSQL if it is unavailable.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

# Private MinIO bucket for processed product images.
MINIO_ENDPOINT=127.0.0.1:9010
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=product-images
MINIO_SECURE=false

# Generate with: openssl rand -hex 32. Never commit the real value.
JWT_SECRET_KEY=change_me_to_a_random_32_byte_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_COOKIE_SECURE=false

# Redis-backed fixed-window rate limits. Optional: leave empty to use
# JWT_SECRET_KEY, or set a separate random secret outside version control.
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_MINUTE=10
RATE_LIMIT_MUTATION_PER_MINUTE=30
RATE_LIMIT_IMAGE_UPLOAD_PER_MINUTE=10
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=60
# Only list reverse-proxy IPs here. Direct client X-Forwarded-For is ignored.
TRUSTED_PROXY_IPS=[]
# Enable only after HTTPS is terminated for this API.
SECURITY_HSTS_ENABLED=false
